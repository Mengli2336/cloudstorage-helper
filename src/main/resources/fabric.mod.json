{
	"schemaVersion": 1,
	"id": "cloudstorage-helper",
	"version": "${version}",
	"name": "Cloud Storage Helper",
	"description": "梦幻之屿服务器云仓辅助模组。在 REI/JEI 中显示云仓数量并支持快捷取出，支持自定义数量、潜影盒和书签数量，以及通过世界准星从方块、掉落物和 Litematica 投影快速取物；配置与热键基于 MaLiLib。",
	"authors": [
		"Mengli2336"
	],
	"license": "CC0-1.0",
	"icon": "assets/cloudstorage-helper/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.cloudstoragerei.CloudStorageModClient"
		],
		"modmenu": [
			"com.cloudstoragerei.compat.modmenu.CloudStorageModMenuIntegration"
		],
		"rei_client": [
			"com.cloudstoragerei.compat.rei.CloudStorageReiPlugin"
		],
		"jei_mod_plugin": [
			"com.cloudstoragerei.compat.jei.CloudStorageJeiPlugin"
		]
	},
	"mixins": [
		{
			"config": "cloudstorage-helper.jei.mixins.json",
			"environment": "client"
		},
		{
			"config": "cloudstorage-helper.rei.mixins.json",
			"environment": "client"
		},
		{
			"config": "cloudstorage-helper.litematica.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": ">=0.155.2+26.1.2",
		"malilib": ">=0.28.9- <0.29.0-"
	},
	"suggests": {
		"modmenu": "*",
		"jei": ">=29.37.0",
		"roughlyenoughitems": ">=26.1.819",
		"litematica": ">=0.27.14"
	}
}
